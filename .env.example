# Copy to .env and fill in a key from Google AI Studio.
# Either name works. The key stays on this machine; speech-to-text is local.
GEMINI_API_KEY=
GOOGLE_API_KEY=

# Fast default. thinking is turned off for 2.5 Flash.
# Faster: gemini-2.5-flash-lite
# Newer:  gemini-3.8-flash  (uses low thinking — a bit slower, stronger)
GEMINI_MODEL=gemini-2.5-flash

# tiny is fastest, base is the default, small is more accurate for Arabic.
WHISPER_MODEL=base
# auto | cpu | cuda
WHISPER_DEVICE=auto
# auto | int8 | float16 | float32
WHISPER_COMPUTE_TYPE=auto
# Blank = detect Arabic or English per utterance. Or set ar / en.
WHISPER_LANGUAGE=

# edge (default, free) or elevenlabs
TTS_PROVIDER=edge
EDGE_VOICE_EN=en-US-GuyNeural
EDGE_VOICE_AR=ar-SA-HamedNeural
EDGE_TTS_RATE=+12%

# Used only when TTS_PROVIDER=elevenlabs
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_flash_v2_5

# Mic / speaker indexes or name fragments from: python -m jarvis --list-devices
INPUT_DEVICE=
OUTPUT_DEVICE=
SAMPLE_RATE=16000

# How long silence must last before a phrase is sent to Whisper.
VAD_SILENCE_MS=650
VAD_MIN_SPEECH_MS=250
VAD_MIN_RMS=0.008
VAD_MULTIPLIER=2.8
MAX_UTTERANCE_S=18
